# ── Triadr environment ───────────────────────────────────────────────────────
# Copy to .env and fill in only what you need. Every app falls back to a
# deterministic SIMULATED mode when its credential is absent, so the full demo
# runs offline with no accounts at all. Loaded by env.py (stdlib, no dotenv).
#
# Step-by-step, with the minimum scopes:  docs/LIVE_SETUP.md
# Prove each app against its real API:    python3 scripts/live_check.py

# ── App #1 · GitHub (code audit) ─────────────────────────────────────────────
# Fine-grained PAT - Pull requests: read · Checks: read · Commit statuses: read & write.
GITHUB_TOKEN=
TRIADR_REPO=owner/repo
TRIADR_PR=42

# ── App #2 · Telegram (team approval) ────────────────────────────────────────
# Bot token from @BotFather (/newbot). No scopes, no admin approval.
TELEGRAM_BOT_TOKEN=
# Chat to post approvals in: a user id, a group id (negative) or @public_channel.
# Leave blank the first time - `scripts/live_check.py` discovers it once you have
# sent the bot any message (bots cannot start a conversation).
TRIADR_TELEGRAM_CHAT_ID=
# Seconds a human has to press Approve / Reject. Simulator default is 30.
TRIADR_APPROVAL_TIMEOUT=120

# ── App #3 · Stripe (escrow payout) ──────────────────────────────────────────
# TEST-mode key only. Triadr refuses to move money on an sk_live_ key unless
# TRIADR_ALLOW_LIVE_MONEY=1 is also set - leave that unset.
STRIPE_SECRET_KEY=
# Connected account the escrow is released to. `scripts/live_check.py --stripe-setup`
# creates a test one and prints its id.
TRIADR_CONTRACTOR_ACCOUNT=
TRIADR_PAYOUT_AMOUNT=25.00
TRIADR_CURRENCY=usd
# TRIADR_ALLOW_LIVE_MONEY=1

# ── Reliability engine ───────────────────────────────────────────────────────
# HMAC key for signing the run attestation. Without it the hash chain is still
# tamper-evident, just unsigned.
TRIADR_LOG_KEY=
TRIADR_LOG_DIR=.triadr
# Risk score at or above which the payout needs human approval (0–100).
TRIADR_APPROVAL_THRESHOLD=30

# LIVE mode routes each app to its one real API. If you run real MCP gateways,
# list them and the gate will fail over across them (comma-separated).
# TRIADR_GITHUB_ENDPOINTS=https://gw-a.example/github,https://gw-b.example/github
# TRIADR_TELEGRAM_ENDPOINTS=
# TRIADR_STRIPE_ENDPOINTS=

# Start the MCP stdio server with chaos already armed.
# TRIADR_CHAOS=1

# ── Optional: LLM parameter extraction ───────────────────────────────────────
# The planner is deterministic by default. Setting this lets Claude extract the
# parameters from the instruction; it never gets to invent workflow steps, and
# whatever it returns is still schema-validated before anything executes.
# TRIADR_LLM_PLANNER=1
ANTHROPIC_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the Next.js dev server proxies /api/* (defaults to port 8000).
TRIADR_API_URL=http://127.0.0.1:8000
